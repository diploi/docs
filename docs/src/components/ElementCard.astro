---
import type { CollectionEntry } from 'astro:content';

interface Props {
  element: CollectionEntry<'elements'>['data'];
}

const { element } = Astro.props;
---

<a href={`/${element.pageId}`} class="element-card flex items-center gap-2 no-underline">
  <img src={element.iconUrl} alt="" class="element-icon" width={28} height={28} loading="lazy" />
  <strong>{element.name}</strong>
</a>

<style>
  .element-card {
    color: var(--sl-color-white);
  }
  .element-card:hover strong {
    color: var(--sl-color-accent-high);
  }
</style>
