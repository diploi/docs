---
import { getCollection } from 'astro:content';
import { compareElements, type ElementType } from '../elements/api';
import ElementCard from './ElementCard.astro';

interface Props {
  type: ElementType;
  /** Names of the elements to show; all of the type by default */
  elementsToShow?: string[];
  heading?: string;
  hideHeading?: boolean;
}

const { type, elementsToShow = [], heading, hideHeading = false } = Astro.props;

const defaultHeadings: Record<ElementType, string> = {
  component: 'Components available',
  addon: 'Add-ons available',
  starter: 'Starter kits available',
};

const elements = (
  await getCollection('elements', ({ data }) => data.type === type && !data.hidden && (elementsToShow.length === 0 || elementsToShow.includes(data.name)))
)
  .map(({ data }) => data)
  .sort(compareElements);

const displayHeading = heading || defaultHeadings[type];
---

{!hideHeading && <h4>{displayHeading}</h4>}

<div class="flex gap-8 items-baseline flex-wrap">
  {elements.map((element) => <ElementCard element={element} />)}
</div>
